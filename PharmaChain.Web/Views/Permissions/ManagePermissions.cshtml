@{
    ViewData["Title"] = "ManagePermissions";
    Layout = "~/Views/Shared/_adminDashboard.cshtml";
}
<div id="managePermissionsPage"></div>
<div id="mainContent">
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Role Permissions</h3>
                    <p class="text-subtitle text-muted">Manage what each role can access and perform.</p>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first">
                    <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="#">Roles</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Permissions</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards — same structure as Users page -->
    <section class="row stats-row mb-3">
        <div class="col-6 col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon green mb-2">
                                <i class="bi bi-shield-check"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Granted</h6>
                            <h6 class="font-extrabold mb-0" id="statGranted">0</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon red mb-2">
                                <i class="bi bi-shield-x"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Denied</h6>
                            <h6 class="font-extrabold mb-0" id="statDenied">0</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon blue mb-2">
                                <i class="bi bi-collection"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Total</h6>
                            <h6 class="font-extrabold mb-0" id="statTotal">0</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon yellow mb-2">
                                <i class="bi bi-person-badge"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Coverage</h6>
                            <h6 class="font-extrabold mb-0" id="statCoverage">0%</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Role Pills + Permission Grid — wrapped in Users-style card -->
    <section class="section">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h4 class="card-title mb-0">Permission Matrix</h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-light-secondary btn-sm" onclick="clearAll()">
                        <i class="bi bi-x-circle me-1"></i>Clear All
                    </button>
                    <button class="btn btn-light-success btn-sm" onclick="grantAll()">
                        <i class="bi bi-check2-all me-1"></i>Grant All
                    </button>
                    <button class="btn btn-primary btn-sm" onclick="savePermissions()">
                        <i class="bi bi-floppy me-1"></i>Save Changes
                    </button>
                </div>
            </div>
            <div class="card-body">

                <!-- Role Selector -->
                <div class="mb-3">
                    <p class="section-lbl">Select Role</p>
                    <div class="d-flex flex-wrap gap-2" id="rolePills"></div>
                </div>

                <!-- Info alert -->
                <div class="alert alert-light-primary d-flex align-items-center gap-2 py-2 mb-3" id="infoAlert">
                    <i class="bi bi-info-circle-fill"></i>
                    <span style="font-size:13px;">Editing permissions for <strong id="currentRoleLabel">—</strong>. Toggle individual permissions or use group controls.</span>
                    <span class="badge bg-primary ms-auto" id="roleBadge">—</span>
                </div>

                <!-- Permission Groups -->
                <div id="permGrid" class="d-flex flex-column gap-2"></div>

            </div>
        </div>
    </section>
</div>
