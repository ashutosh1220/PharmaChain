@using PharmaChain.Application.DTOs;

@{
    Layout = null;
    var currentPage = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

@{
    var permList = ViewBag.Permissions as List<PermissionResponse>;
    var perms = new HashSet<int>(permList?.Select(p => p.PermissionId) ?? Enumerable.Empty<int>());
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/assets/compiled/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/compiled/css/app-dark.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/compiled/css/iconly.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/custom-stylings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/inventory-stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/supplier-stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/batch-stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/purchase-invoice-stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/static/css/stock-requests-stylesheet.css" asp-append-version="true" />
    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #1a1d27;
            --surface: #222635;
            --surface2: #272b3b;
            --surface3: #2e3347;
            --border: rgba(255,255,255,0.07);
            --border2: rgba(255,255,255,0.11);
            --text: #d0d2d6;
            --text-muted: #7a7f9a;
            --text-dim: #4a5068;
            --primary: #7367f0;
            --success: #28c76f;
            --danger: #ea5455;
            --warning: #ff9f43;
            --info: #00cfe8;
            --font: 'Nunito',sans-serif;
        }

        html {
            font-size: 90%;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.5;
            user-select: none;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 99px;
        }

        /* ═══════════════════════════════════════════════════
                           LOADER COMPONENT STYLES — copy these into your project
                        ═══════════════════════════════════════════════════ */

        /* ── Full-page overlay loader ── */
        .mz-loader-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 16, 22, 0.78);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 18px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }

            .mz-loader-overlay.show {
                opacity: 1;
                visibility: visible;
            }

        /* ── Inline / standalone loader ── */
        .mz-loader {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
        }

        /* ── The spinner itself ── */
        .mz-spinner {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            /* SVG circle tracks */
            .mz-spinner svg {
                position: absolute;
                top: 0;
                left: 0;
                transform: rotate(-90deg);
            }

        .mz-spinner-inner {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            position: absolute !important;
            top: 50% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) !important;
        }

        /* Glow ring */
        .mz-spinner::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            opacity: 0.18;
            animation: mz-glow-pulse 2s ease-in-out infinite;
        }

        /* Track (background circle) */
        .mz-track {
            fill: none;
        }
        /* Arc (animated circle) */
        .mz-arc {
            fill: none;
            stroke-linecap: round;
            animation: mz-spin-arc 1.4s cubic-bezier(.4,0,.2,1) infinite;
            transform-origin: center;
        }
        /* Second arc — trailing ghost */
        .mz-arc-ghost {
            fill: none;
            stroke-linecap: round;
            animation: mz-spin-arc 1.4s cubic-bezier(.4,0,.2,1) infinite;
            animation-delay: -0.3s;
            opacity: 0.25;
            transform-origin: center;
        }

        @@keyframes mz-spin-arc {
            0% {
                stroke-dashoffset: var(--circ);
                transform: rotate(0deg);
            }

            50% {
                stroke-dashoffset: calc(var(--circ) * 0.25);
            }

            100% {
                stroke-dashoffset: var(--circ);
                transform: rotate(360deg);
            }
        }

        @@keyframes mz-glow-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.18;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.08;
            }
        }

        /* ── SIZE VARIANTS ── */
        /* sm — 28px */
        .mz-loader-sm .mz-spinner {
            width: 28px;
            height: 28px;
        }

            .mz-loader-sm .mz-spinner svg {
                width: 28px;
                height: 28px;
            }

        .mz-loader-sm .mz-spinner-inner {
            width: 16px;
            height: 16px;
            font-size: 10px;
        }

        .mz-loader-sm .mz-spinner::after {
            width: 34px;
            height: 34px;
            inset: -3px;
        }

        .mz-loader-sm .mz-arc {
            stroke-width: 2.8;
            --circ: 75.4;
            stroke-dasharray: 75.4;
        }

        .mz-loader-sm .mz-arc-ghost {
            stroke-width: 2.8;
            --circ: 75.4;
            stroke-dasharray: 75.4;
        }

        .mz-loader-sm .mz-track {
            stroke-width: 2.8;
        }

        /* md — 48px (default) */
        .mz-loader-md .mz-spinner {
            width: 48px;
            height: 48px;
        }

            .mz-loader-md .mz-spinner svg {
                width: 48px;
                height: 48px;
            }

        .mz-loader-md .mz-spinner-inner {
            width: 28px;
            height: 28px;
            font-size: 16px;
        }

        .mz-loader-md .mz-spinner::after {
            width: 58px;
            height: 58px;
            inset: -5px;
        }

        .mz-loader-md .mz-arc {
            stroke-width: 3.5;
            --circ: 131;
            stroke-dasharray: 131;
        }

        .mz-loader-md .mz-arc-ghost {
            stroke-width: 3.5;
            --circ: 131;
            stroke-dasharray: 131;
        }

        .mz-loader-md .mz-track {
            stroke-width: 3.5;
        }

        /* lg — 72px */
        .mz-loader-lg .mz-spinner {
            width: 72px;
            height: 72px;
        }

            .mz-loader-lg .mz-spinner svg {
                width: 72px;
                height: 72px;
            }

        .mz-loader-lg .mz-spinner-inner {
            width: 44px;
            height: 44px;
            font-size: 22px;
        }

        .mz-loader-lg .mz-spinner::after {
            width: 86px;
            height: 86px;
            inset: -7px;
        }

        .mz-loader-lg .mz-arc {
            stroke-width: 4.5;
            --circ: 197;
            stroke-dasharray: 197;
        }

        .mz-loader-lg .mz-arc-ghost {
            stroke-width: 4.5;
            --circ: 197;
            stroke-dasharray: 197;
        }

        .mz-loader-lg .mz-track {
            stroke-width: 4.5;
        }

        /* xl — 100px */
        .mz-loader-xl .mz-spinner {
            width: 100px;
            height: 100px;
        }

            .mz-loader-xl .mz-spinner svg {
                width: 100px;
                height: 100px;
            }

        .mz-loader-xl .mz-spinner-inner {
            width: 62px;
            height: 62px;
            font-size: 28px;
        }

        .mz-loader-xl .mz-spinner::after {
            width: 118px;
            height: 118px;
            inset: -9px;
        }

        .mz-loader-xl .mz-arc {
            stroke-width: 5.5;
            --circ: 276;
            stroke-dasharray: 276;
        }

        .mz-loader-xl .mz-arc-ghost {
            stroke-width: 5.5;
            --circ: 276;
            stroke-dasharray: 276;
        }

        .mz-loader-xl .mz-track {
            stroke-width: 5.5;
        }

        /* ── COLOR VARIANTS ── */
        .mz-loader-primary .mz-arc {
            stroke: var(--primary);
        }

        .mz-loader-primary .mz-arc-ghost {
            stroke: var(--primary);
        }

        .mz-loader-primary .mz-track {
            stroke: rgba(115,103,240,0.12);
        }

        .mz-loader-primary .mz-spinner::after {
            background: var(--primary);
        }

        .mz-loader-primary .mz-spinner-inner {
            color: var(--primary);
        }

        .mz-loader-success .mz-arc {
            stroke: var(--success);
        }

        .mz-loader-success .mz-arc-ghost {
            stroke: var(--success);
        }

        .mz-loader-success .mz-track {
            stroke: rgba(40,199,111,0.12);
        }

        .mz-loader-success .mz-spinner::after {
            background: var(--success);
        }

        .mz-loader-success .mz-spinner-inner {
            color: var(--success);
        }

        .mz-loader-danger .mz-arc {
            stroke: var(--danger);
        }

        .mz-loader-danger .mz-arc-ghost {
            stroke: var(--danger);
        }

        .mz-loader-danger .mz-track {
            stroke: rgba(234,84,85,0.12);
        }

        .mz-loader-danger .mz-spinner::after {
            background: var(--danger);
        }

        .mz-loader-danger .mz-spinner-inner {
            color: var(--danger);
        }

        .mz-loader-warning .mz-arc {
            stroke: var(--warning);
        }

        .mz-loader-warning .mz-arc-ghost {
            stroke: var(--warning);
        }

        .mz-loader-warning .mz-track {
            stroke: rgba(255,159,67,0.12);
        }

        .mz-loader-warning .mz-spinner::after {
            background: var(--warning);
        }

        .mz-loader-warning .mz-spinner-inner {
            color: var(--warning);
        }

        .mz-loader-info .mz-arc {
            stroke: var(--info);
        }

        .mz-loader-info .mz-arc-ghost {
            stroke: var(--info);
        }

        .mz-loader-info .mz-track {
            stroke: rgba(0,207,232,0.12);
        }

        .mz-loader-info .mz-spinner::after {
            background: var(--info);
        }

        .mz-loader-info .mz-spinner-inner {
            color: var(--info);
        }

        /* ── Loader label ── */
        .mz-loader-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.3px;
            animation: mz-label-fade 1.4s ease-in-out infinite;
        }

        .mz-loader-sm .mz-loader-label {
            font-size: 11px;
        }

        .mz-loader-lg .mz-loader-label {
            font-size: 14px;
        }

        .mz-loader-xl .mz-loader-label {
            font-size: 15px;
        }

        @@keyframes mz-label-fade {
            0%, 100% {
                opacity: 0.5;
            }

            50% {
                opacity: 1;
            }
        }

        /* Overlay label (white-ish) */
        .mz-loader-overlay .mz-loader-label {
            color: rgba(255,255,255,0.7);
            font-size: 14px;
        }

        /* ── Button loader state ── */
        .mz-btn-loading {
            position: relative;
            pointer-events: none;
            opacity: 0.85;
        }

            .mz-btn-loading .mz-btn-spinner {
                display: inline-block;
                width: 14px;
                height: 14px;
                border: 2px solid rgba(255,255,255,0.25);
                border-top-color: #fff;
                border-radius: 50%;
                animation: mz-btn-spin 0.7s linear infinite;
                vertical-align: middle;
                margin-right: 6px;
                flex-shrink: 0;
            }

        @@keyframes mz-btn-spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Card skeleton loader ── */
        .mz-skeleton {
            background: linear-gradient(90deg, var(--surface2) 25%, var(--surface3) 50%, var(--surface2) 75%);
            background-size: 200% 100%;
            animation: mz-skeleton-wave 1.6s ease-in-out infinite;
            border-radius: 5px;
        }

        @@keyframes mz-skeleton-wave {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }
        /* Cards — match Users page: clean border, no heavy shadow */
        .card {
            border-radius: 8px !important;
            box-shadow: 0 2px 6px rgba(0,0,0,0.18) !important;
            border: 1px solid rgba(255,255,255,0.07) !important;
            margin-bottom: 0 !important;
            overflow: hidden !important;
        }
        /* Permission group cards — same as main table card */
        #permGrid .card {
            border: 1px solid rgba(255,255,255,0.07) !important;
        }

        /* Compact page heading */
        .page-heading {
            margin-bottom: 10px !important;
        }

        .page-title h3 {
            font-size: 16px !important;
            margin-bottom: 1px !important;
        }

        .text-subtitle {
            font-size: 12px !important;
            margin-bottom: 0 !important;
        }

        /* Tighter main content padding */
        #mainContent {
            padding: 14px 18px !important;
        }

        /* Buttons */
        .btn {
            border-radius: 5px !important;
            font-size: 12px !important;
            padding: 4px 10px !important;
        }

        .btn-sm {
            padding: 3px 9px !important;
            font-size: 12px !important;
        }

        /* Role pill active */
        .role-pill.active {
            background: var(--bs-primary) !important;
            color: #fff !important;
            border-color: var(--bs-primary) !important;
        }

        /* Badge */
        .badge {
            border-radius: 4px !important;
            font-weight: 500 !important;
            font-size: 11px !important;
        }

        /* Alert compact */
        .alert {
            padding: 7px 12px !important;
            font-size: 12px !important;
            margin-bottom: 10px !important;
        }

        /* Custom toggle */
        .perm-toggle {
            position: relative;
            display: inline-block;
            width: 32px;
            height: 18px;
            flex-shrink: 0;
        }

            .perm-toggle input {
                opacity: 0;
                width: 0;
                height: 0;
            }

            .perm-toggle .slider {
                position: absolute;
                inset: 0;
                background: rgba(255,255,255,0.1);
                border: 2px solid gray;
                border-radius: 99px;
                transition: 0.15s;
                cursor: pointer;
            }

                .perm-toggle .slider::before {
                    content: '';
                    position: absolute;
                    width: 12px;
                    height: 12px;
                    left: 2px;
                    top: 1px;
                    background: #6c757d;
                    border-radius: 50%;
                    transition: 0.15s;
                }

            .perm-toggle input:checked + .slider {
                background: #198754;
                border-color: #198754;
            }

                .perm-toggle input:checked + .slider::before {
                    transform: translateX(14px);
                    background: #fff;
                }

        /* Permission row — compact */
        .perm-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: background 0.12s;
            cursor: pointer;
            border: 1px solid #6334344f;
        }

            .perm-row:last-child {
                border-bottom: none;
            }

            .perm-row:hover {
                background: rgba(255,255,255,0.03);
            }

            .perm-row.granted {
                background: rgba(25,135,84,0.08);
            }

                .perm-row.granted:hover {
                    background: rgba(25,135,84,0.13);
                }

        .perm-id {
            font-size: 10px;
            color: #6c757d;
            width: 20px;
            flex-shrink: 0;
            font-weight: 600;
        }

        .perm-action {
            font-size: 12px;
            font-weight: 500;
            line-height: 1.3;
        }

        .perm-module {
            font-size: 10.5px;
            color: #6c757d;
        }

        /* Group header — compact */
        .group-header {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.02);
        }

        .group-count {
            font-size: 10.5px;
            color: #6c757d;
            margin-left: 3px;
        }

        .toggle-all-link {
            margin-left: auto;
            font-size: 11px;
            color: #6c757d;
            cursor: pointer;
            transition: color 0.12s;
        }

            .toggle-all-link:hover {
                color: var(--bs-primary);
            }

        /* Perm items grid — more columns, denser */
        .perm-items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        }

            .perm-items-grid .perm-row {
                border-right: 1px solid #6334344f;
            }

        /* Stats row — match Users page stats cards exactly */
        .stats-row .card {
            cursor: default;
        }

            .stats-row .card.active-stat {
                border: 1px solid rgba(var(--bs-primary-rgb), 0.4) !important;
                box-shadow: 0 0 0 2px rgba(var(--bs-primary-rgb), 0.12) !important;
            }

        .stats-row .card-body {
            padding: 12px 14px !important;
        }

        /* Section label */
        .section-lbl {
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: .7px;
            text-transform: uppercase;
            color: #6c757d;
            margin-bottom: 6px;
        }

        /* perm grid gap */
        #permGrid {
            gap: 8px !important;
        }

        /* Toast */
        .toast-custom {
            position: fixed;
            bottom: 18px;
            right: 18px;
            background: var(--bs-body-bg);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            padding: 9px 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            z-index: 9999;
            opacity: 0;
            transform: translateY(12px);
            transition: all 0.2s ease;
            pointer-events: none;
        }

            .toast-custom.show {
                opacity: 1;
                transform: translateY(0);
                pointer-events: all;
            }

        /* ═══════════════════════════════════════════════
                                           POPUP OVERLAY
                                        ═══════════════════════════════════════════════ */
        .mz-popup-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.22s ease, visibility 0.22s ease;
        }

            .mz-popup-overlay.open {
                opacity: 1;
                visibility: visible;
            }

        /* ═══════════════════════════════════════════════
                                           POPUP BOX
                                        ═══════════════════════════════════════════════ */
        .mz-popup {
            background: var(--bs-body-bg, #1a1d23);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 12px;
            box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 4px 16px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
            transform: scale(0.93) translateY(10px);
            transition: transform 0.22s cubic-bezier(.34,1.4,.64,1), opacity 0.22s ease;
            opacity: 0;
        }

        .mz-popup-overlay.open .mz-popup {
            transform: scale(1) translateY(0);
            opacity: 1;
        }

        /* ── Icon header band ── */
        .mz-popup-icon-band {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px 24px 16px;
            position: relative;
        }

        .mz-popup-icon-wrap {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            position: relative;
        }
            /* Subtle animated ring */
            .mz-popup-icon-wrap::after {
                content: '';
                position: absolute;
                inset: -5px;
                border-radius: 50%;
                border: 1.5px solid;
                opacity: 0.25;
                animation: mz-ring-pulse 2.2s ease-in-out infinite;
            }

        @@keyframes mz-ring-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.25;
            }

            50% {
                transform: scale(1.12);
                opacity: 0.1;
            }
        }

        /* Variants — icon colours */
        .mz-popup.success .mz-popup-icon-wrap {
            background: rgba(40,199,111,0.15);
            color: #28c76f;
        }

            .mz-popup.success .mz-popup-icon-wrap::after {
                border-color: #28c76f;
            }

        .mz-popup.danger .mz-popup-icon-wrap {
            background: rgba(234,84,85,0.14);
            color: #ea5455;
        }

            .mz-popup.danger .mz-popup-icon-wrap::after {
                border-color: #ea5455;
            }

        .mz-popup.warning .mz-popup-icon-wrap {
            background: rgba(255,159,67,0.14);
            color: #ff9f43;
        }

            .mz-popup.warning .mz-popup-icon-wrap::after {
                border-color: #ff9f43;
            }

        .mz-popup.info .mz-popup-icon-wrap {
            background: rgba(0,207,232,0.13);
            color: #00cfe8;
        }

            .mz-popup.info .mz-popup-icon-wrap::after {
                border-color: #00cfe8;
            }

        .mz-popup.primary .mz-popup-icon-wrap {
            background: rgba(115,103,240,0.14);
            color: #7367f0;
        }

            .mz-popup.primary .mz-popup-icon-wrap::after {
                border-color: #7367f0;
            }

        /* ── Body ── */
        .mz-popup-body {
            padding: 0 24px 6px;
            text-align: center;
        }

        .mz-popup-title {
            font-size: 17px;
            font-weight: 600;
            color: var(--bs-body-color, #d0d2d6);
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .mz-popup-message {
            font-size: 13.5px;
            color: var(--bs-secondary-color, #6e6b7b);
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* ── Divider ── */
        .mz-popup-divider {
            height: 1px;
            background: rgba(255,255,255,0.07);
            margin: 18px 0 0;
        }

        /* ── Footer ── */
        .mz-popup-footer {
            padding: 14px 24px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        /* ── OK Button (full-width primary) ── */
        .mz-popup-btn-ok {
            flex: 1;
            padding: 9px 20px;
            border-radius: 6px;
            border: none;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            letter-spacing: 0.2px;
        }

            .mz-popup-btn-ok:hover {
                filter: brightness(1.1);
            }

            .mz-popup-btn-ok:active {
                transform: scale(0.97);
            }

        .mz-popup.success .mz-popup-btn-ok {
            background: #28c76f;
            color: #fff;
        }

        .mz-popup.danger .mz-popup-btn-ok {
            background: #ea5455;
            color: #fff;
        }

        .mz-popup.warning .mz-popup-btn-ok {
            background: #ff9f43;
            color: #fff;
        }

        .mz-popup.info .mz-popup-btn-ok {
            background: #00cfe8;
            color: #fff;
        }

        .mz-popup.primary .mz-popup-btn-ok {
            background: #7367f0;
            color: #fff;
        }

        /* ── Cancel Button (ghost) ── */
        .mz-popup-btn-cancel {
            flex: 1;
            padding: 9px 20px;
            border-radius: 6px;
            border: 1px solid rgba(255,255,255,0.12);
            background: transparent;
            color: var(--bs-secondary-color, #6e6b7b);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, color 0.15s, transform 0.1s;
        }

            .mz-popup-btn-cancel:hover {
                background: rgba(255,255,255,0.06);
                color: var(--bs-body-color, #d0d2d6);
            }

            .mz-popup-btn-cancel:active {
                transform: scale(0.97);
            }

        /* ── Close X ── */
        .mz-popup-close {
            position: absolute;
            top: 14px;
            right: 16px;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: none;
            background: rgba(255,255,255,0.06);
            color: var(--bs-secondary-color, #6e6b7b);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.15s, color 0.15s;
        }

            .mz-popup-close:hover {
                background: rgba(255,255,255,0.12);
                color: var(--bs-body-color);
            }


    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

