    <div class="modal-backdrop-custom" id="addRoleModal" onclick="handleBackdropClick(event)">
        <div class="modal-box">
            <div class="modal-box-header">
                <div class="modal-icon"><i class="bi bi-shield-plus"></i></div>
                <div>
                    <h5>Add New Role</h5>
                    <p>Enter a name to create a new role.</p>
                </div>
                <button class="btn-close-modal" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-box-body">
                <label for="roleNameInput">Role Name <span style="color:#dc3545;">*</span></label>
                <input type="text" id="roleNameInput" class="form-control" placeholder="e.g. Warehouse Manager" maxlength="50" oninput="clearError()" onkeydown="handleModalKey(event)" autocomplete="off" />
                <div class="modal-field-hint" id="charCount">0 / 50 characters</div>
                <div class="modal-error-msg" id="roleNameError">
                    <i class="bi bi-exclamation-circle me-1"></i><span id="roleNameErrorText">Role name is required.</span>
                </div>
            </div>
            <div class="modal-success-flash" id="successFlash">
                <i class="bi bi-check-circle-fill"></i>
                <span id="successMsg">Role added successfully!</span>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-cancel" onclick="closeModal()">Cancel</button>
                <button class="btn btn-submit" id="submitRoleBtn" onclick="submitRole()">
                    <i class="bi bi-check2 me-1"></i> Add Role
                </button>
            </div>
        </div>
    </div>

