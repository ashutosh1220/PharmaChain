            <div class="del-modal-header">
                <div class="del-modal-icon"><i class="bi bi-trash3-fill"></i></div>
                <div style="flex:1;">
                    <p class="del-modal-title">Delete Role</p>
                    <p class="del-modal-subtitle">You are about to delete <strong id="delRoleName">-</strong>. This action cannot be undone.</p>
                </div>
                <button class="del-modal-btn-close" onclick="closeDeleteModal()"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="del-modal-warn" id="delWarnBox">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span id="delWarnText">This role is currently assigned to users.</span>
            </div>
            <div class="del-modal-body">
                <label for="delConfirmInput">Type <strong id="delConfirmLabel">-</strong> to confirm</label>
                <input type="text" id="delConfirmInput" class="form-control" placeholder="Type role name here..." oninput="delCheckConfirm()" onkeydown="delHandleKey(event)" autocomplete="off" />
                <div class="del-modal-mismatch" id="delMismatch"><i class="bi bi-exclamation-circle me-1"></i>Name does not match.</div>
            </div>
            <div class="del-success-flash" id="delSuccessFlash">
                <i class="bi bi-check-circle-fill"></i>
                <span id="delSuccessMsg">Role deleted successfully!</span>
            </div>
            <hr class="del-modal-divider">
            <div class="del-modal-footer">
                <button class="btn-cancel-del" onclick="closeDeleteModal()">Cancel</button>
                <button class="btn-del-confirm" id="delConfirmBtn" disabled onclick="execDeleteRole()">
                    <i class="bi bi-trash3 me-1"></i> Delete Role
                </button>
