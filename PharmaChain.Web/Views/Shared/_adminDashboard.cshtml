            <div class="mz-popup-footer" id="mzPopupFooter" style="border-top: 1px solid #4f494975;">
                <button class="mz-popup-btn-cancel" id="mzPopupCancel" onclick="MzPopup._handleCancel()" style="border: 1px solid #4f494975;
    border-radius: 5px;">
                    Cancel
                </button>
                <button class="mz-popup-btn-ok" id="mzPopupOk" onclick="MzPopup._handleOk()" style="border: 1px solid #4f494975;
    border-radius: 5px;">
                    OK
                </button>
            </div>

        </div>
    </div>

    <div class="mz-loader-overlay" id="mzPageLoader">
        <div class="mz-loader mz-loader-lg" id="mzPageLoaderInner">
            <div class="mz-spinner">
                <svg viewBox="0 0 72 72">
                    <circle class="mz-track" cx="36" cy="36" r="31.4" />
                    <circle class="mz-arc-ghost" cx="36" cy="36" r="31.4" />
                    <circle class="mz-arc" cx="36" cy="36" r="31.4" />
                </svg>
                <div class="mz-spinner-inner">
                    <i class="bi bi-capsule-pill" style="position: relative; top: -10px; right: 5px;"></i>
                </div>
            </div>
            <span class="mz-loader-label" id="mzPageLoaderLabel">Loading…</span>
        </div>
    </div>

    <script src="~/assets/static/js/components/dark.js" asp-append-version="true"></script>
    <script src="~/assets/static/js/jquery-4.0.0.min.js" asp-append-version="true"></script>
    <script src="~/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js" asp-append-version="true"></script>
    <script src="~/assets/compiled/js/app.js" asp-append-version="true"></script>
    <script src="~/assets/extensions/apexcharts/apexcharts.min.js" asp-append-version="true"></script>
    <script src="~/assets/static/js/components/mz-popup.js" asp-append-version="true"></script>
    <script src="~/assets/static/js/app.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" asp-append-version="true"></script>

    <script>
        function tnav(el){el.classList.toggle('open');}

        function changeAvatar(e){
          const f=e.target.files[0];if(!f)return;
          const r=new FileReader();
          r.onload=ev=>{
            const img=document.getElementById('avImg');
            img.src=ev.target.result;img.style.display='block';
            document.getElementById('avInit').style.display='none';
            toast('Profile photo updated.','success');
          };r.readAsDataURL(f);
        }

        function te(id){
          const inp=document.getElementById(id);
          const eb=document.getElementById('eb-'+id);
          const sb=document.getElementById('sb-'+id);
          if(inp.disabled){
            inp.disabled=false;inp.focus();
            eb.innerHTML='<i class="bi bi-x-lg"></i>';eb.title='Cancel';eb.classList.add('cx');
            if(sb)sb.classList.add('vis');
          }else{
            inp.disabled=true;
            eb.innerHTML='<i class="bi bi-pencil"></i>';eb.title='Edit';eb.classList.remove('cx');
            if(sb)sb.classList.remove('vis');
          }
        }

        function sf(id){
          const inp=document.getElementById(id);
          const eb=document.getElementById('eb-'+id);
          const sb=document.getElementById('sb-'+id);
          const dispId=inp.dataset.disp;
          if(dispId){
            const d=document.getElementById(dispId);
            if(d)d.textContent=inp.tagName==='SELECT'?inp.options[inp.selectedIndex].text:inp.value;
          }
          inp.disabled=true;
          eb.innerHTML='<i class="bi bi-pencil"></i>';eb.title='Edit';eb.classList.remove('cx');
          if(sb)sb.classList.remove('vis');
          toast('Field updated successfully.','success');
        }

        function editSec(sec){
          const els=document.querySelectorAll('[data-sec="'+sec+'"]');
          let n=0;els.forEach(el=>{if(el.disabled){te(el.id);n++;}});
          if(n>0)toast(n+' field'+(n>1?'s':'')+' unlocked.','info');
        }

        function syncStatus(v){
          const b=document.getElementById('stBadge');
          const d=document.getElementById('stDot');
          if(v==='Active'){b.className='st-badge on';b.innerHTML='<i class="bi bi-circle-fill" style="font-size:7px;"></i> Active';d.className='st-dot on';}
          else if(v==='Inactive'){b.className='st-badge off';b.innerHTML='<i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactive';d.className='st-dot off';}
          else{b.className='st-badge sus';b.innerHTML='<i class="bi bi-circle-fill" style="font-size:7px;"></i> Suspended';d.className='st-dot off';}
        }

        const TI={success:'bi-check-circle-fill',danger:'bi-x-circle-fill',warning:'bi-exclamation-circle-fill',info:'bi-info-circle-fill'};
        const TC={success:'var(--success)',danger:'var(--danger)',warning:'var(--warning)',info:'var(--info)'};
        let tt;
        function toast(msg,type='success'){
          const el=document.getElementById('toastEl');
          const ic=document.getElementById('toastIc');
          const ms=document.getElementById('toastMsg');
          ms.textContent=msg;ic.className='bi '+(TI[type]||TI.success);ic.style.color=TC[type]||TC.success;
          el.classList.add('vis');clearTimeout(tt);tt=setTimeout(()=>el.classList.remove('vis'),3000);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>