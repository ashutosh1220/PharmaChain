                window.submitApproval = function () {

        const fulfillmentEl = document.getElementById('fulfillmentType');
        const fulfillmentType = fulfillmentEl ? fulfillmentEl.value : null;

        if (!fulfillmentType) {
            MzPopup.show({
                type: 'danger',
                title: 'Validation',
                message: 'Select fulfillment type',
                okText: 'OK'
            });
            return;
        }

        const rows = document.querySelectorAll('.srq__aqty');

        const medicines = [];

        rows.forEach(r => {
            const qty = parseInt(r.value || 0);
            const id = r.getAttribute('data-medicineid');
            const name = r.getAttribute('data-med');

            if (qty > 0 && id) {
                medicines.push({
                    medicineId: id,
                    medicineName: name,
                    qtyApproved: qty  
                });
            }
        });

        if (medicines.length === 0) {
            MzPopup.show({
                type: 'warning',
                title: 'No Medicines',
                message: 'Please enter at least one medicine quantity',
                okText: 'OK'
            });
            return;
        }

        let assignedStockId = reqid;

        if (!assignedStockId) {
            MzPopup.show({
                type: 'danger',
                title: 'Error',
                message: 'AssignedStockId missing',
                okText: 'OK'
            });
            return;
        }

        const payload = {
            assignedStockId: assignedStockId,
            approvedBy: "ADMIN", // or dynamic user
            approvalStatus: "APPROVED",
            fulfillmentType: fulfillmentType,
            remark: "Approved",
            medicines: medicines
        };

        const submitForm = () => {

                fetch('/api/stock/approve', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
    })
    .then(async (res) => {

        const text = await res.text();

        let data;
        try {
            data = text ? JSON.parse(text) : {};
        } catch (e) {
            console.error("Response was not valid JSON:", text);
            throw new Error("Invalid server response");
        }

        if (!res.ok) {
            throw new Error(data?.message || "Request failed");
        }

        const msg = data?.message || "Approved successfully";

        if (data?.success) {
            MzPopup.show({
                type: 'success',
                title: 'Success',
                message: msg,
                okText: 'OK',
                onOk: () => window.location.reload()
            });
        } else {
            MzPopup.show({
                type: 'danger',
                title: 'Failed',
                message: msg,
                okText: 'OK'
            });
        }
    })
    .catch((err) => {
        MzPopup.show({
            type: 'danger',
            title: 'Error',
            message: err.message || "Something went wrong",
            okText: 'OK'
        });
    });
        };

        MzPopup.show({
            type: 'warning',
            title: 'Confirm Action',
            message: 'Are you sure you want to approve this request?',
            okText: 'Yes',
            cancelText: 'Cancel',
            onOk: submitForm
        });
    };

        window.submitReject = function () {

        const assignedStockId = document.getElementById('srq-rejectStockId').value;
        const remark = document.getElementById('srq-rejectRemark').value;

        if (!remark || remark.trim() === '') {
            MzPopup.show({
                type: 'danger',
                title: 'Validation',
                message: 'Remark is required',
                okText: 'OK'
            });
            return;
        }

        const payload = {
            assignedStockId: assignedStockId,
            approvalStatus: "REJECTED",
            remark: remark
        };

        const submit = () => {

            fetch('/api/stock/reject', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                const data = await res.json();

                if (data?.success) {
                    MzPopup.show({
                        type: 'success',
                        title: 'Rejected',
                        message: data.message || 'Request rejected',
                        okText: 'OK',
                        onOk: () => window.location.reload()
                    });
                } else {
                    MzPopup.show({
                        type: 'danger',
                        title: 'Failed',
                        message: data.message || 'Error',
                        okText: 'OK'
                    });
                }
            })
            .catch(err => {
                MzPopup.show({
                    type: 'danger',
                    title: 'Error',
                    message: err.message,
                    okText: 'OK'
                });
            });
        };

        MzPopup.show({
            type: 'warning',
            title: 'Confirm Reject',
            message: 'Are you sure you want to reject this request?',
            okText: 'Yes',
            cancelText: 'No',
            onOk: submit
        });
    };

            window.openRejectForm = function (id) {
        document.getElementById('srq-rejectStockId').value = id;

        const textarea = document.getElementById('srq-rejectRemark');

        textarea.value = '';

        textarea.style.width = "100%";
        textarea.style.minHeight = "50px";
        textarea.style.border = "1px solid #ccc";
        textarea.style.padding = "6px";
        textarea.style.outline = "none";
        textarea.style.borderRadius = "2px";
        textarea.style.fontSize = "13px";
        textarea.style.resize = "vertical";
        textarea.style.fontFamily = "inherit";

        openModal('srq-rejectModal');
    };
           loadRequests();
        }())
    });
</script>

