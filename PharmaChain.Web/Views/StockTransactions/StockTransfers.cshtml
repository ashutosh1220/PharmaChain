            function getRangeDays(range) {
                if (range === 'today') return 1;
                if (range === 'week') return 7;
                if (range === 'month') return 30;
                if (range === '3m') return 90;
                if (range === '6m') return 180;
                return 7;
            }

            function fetchRequestStats(range) {
                const days = getRangeDays(range);
                return fetch(`/api/stockinfo/request-stats?rangeInDays=${days}`)
                    .then(res => res.json());
            }

                function getLast7DaysData() {
        const today = new Date();
        const labels = [];
        const submissions = [];
        const approved = [];

        for (let i = 6; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);

            const dateStr =
                d.getFullYear() + "-" +
                String(d.getMonth() + 1).padStart(2, '0') + "-" +
                String(d.getDate()).padStart(2, '0');

            labels.push(d.toLocaleDateString('en-US', { weekday: 'short' }));

            const dayRequests = requests.filter(r => r.date === dateStr);

            submissions.push(dayRequests.length);

            approved.push(
                dayRequests.filter(x =>
                    (x.status || '').toLowerCase() === 'approved'
                ).length
            );
        }

        return { labels, submissions, approved };
    }

        function getMonthlyWeeklyData() {
        const today = new Date();
        const currentMonth = today.getMonth();
        const currentYear = today.getFullYear();

        const labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5'];
        const submissions = [0, 0, 0, 0, 0];
        const approved = [0, 0, 0, 0, 0];

        requests.forEach(r => {
            const d = new Date(r.date);

            if (isNaN(d)) return;

            if (d.getMonth() !== currentMonth || d.getFullYear() !== currentYear) return;

            const day = d.getDate();
            const weekIndex = Math.min(Math.floor((day - 1) / 7), 4);

            submissions[weekIndex]++;

            if ((r.status || '').toLowerCase() === 'approved') {
                approved[weekIndex]++;
            }
        });

        return { labels, submissions, approved };
    }

        function getMultiMonthData(monthCount = 3) {
        const today = new Date();

        const labels = [];
        const submissions = [];
        const approved = [];

        for (let i = monthCount - 1; i >= 0; i--) {

            const d = new Date(today.getFullYear(), today.getMonth() - i, 1);

            const month = d.getMonth();
            const year = d.getFullYear();

            const label = d.toLocaleString('default', { month: 'short', year: 'numeric' });
            labels.push(label);

            const monthRequests = requests.filter(r => {
                const rd = new Date(r.date);
                return rd.getMonth() === month && rd.getFullYear() === year;
            });

            submissions.push(monthRequests.length);

            approved.push(
                monthRequests.filter(x =>
                    (x.status || '').toLowerCase() === 'approved'
                ).length
            );
        }

        return { labels, submissions, approved };
    }

