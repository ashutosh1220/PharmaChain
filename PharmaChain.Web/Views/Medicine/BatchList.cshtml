@{
    ViewData["Title"] = "Pharma Chain - Medicine batches";
    Layout = "~/Views/Shared/_adminDashboard.cshtml";
}

@{
    int currentPage = ViewBag.page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int CurrentPageSize = ViewBag.size ?? 1;
}

<div class="drawer-overlay" id="medDrawerOverlay"></div>

<div class="log-drawer" id="medDrawer">
    <div class="drawer-head">
        <span class="live-dot"></span>
        <h6>Medicine Batch Detail</h6>
        <span class="badge bg-success bg-opacity-10 text-success" id="medDrawerId" style="font-size:10.5px;">#—</span>
        <button class="drawer-close med-drawer-close-btn"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="drawer-body" id="medDrawerBody"></div>
    <div class="drawer-foot">
        <button class="btn btn-outline-secondary btn-sm med-drawer-close-btn">
            <i class="bi bi-x me-1"></i> Close
        </button>
        <button class="btn btn-primary btn-sm" id="medExportBtn" hidden>
            <i class="bi bi-download me-1"></i> Export JSON
        </button>
    </div>
</div>

<div class="page-heading">
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Medicine Batch Management</h3>
                <p class="text-subtitle text-muted">
                    Manage medicines inventory, details, and availability status.
                </p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Medicines</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- ── Stat Cards ── -->
    <section class="row stats-row mb-3" id="statCards">
        <div class="col-6 col-lg-2 col-md-6">
            <div class="card" style="cursor:pointer;" onclick="filterByStatus('All')" id="card-All">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon blue mb-2">
                                <i class="bi bi-capsule-pill"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Total Medicines</h6>
                            <h6 class="font-extrabold mb-0" id="countAll">@ViewBag.TotalUsers</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2 col-md-6">
            <div class="card" style="cursor:pointer;" onclick="filterByStatus('Active')" id="card-Active">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon green mb-2">
                                <i class="bi bi-capsule"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Active</h6>
                            <h6 class="font-extrabold mb-0" id="countActive">@ViewBag.ActiveUsers</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2 col-md-6">
            <div class="card" style="cursor:pointer;" onclick="filterByStatus('Inactive')" id="card-Inactive">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon red mb-2">
                                <i class="bi bi-x-circle"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Inactive</h6>
                            <h6 class="font-extrabold mb-0" id="countInactive">@ViewBag.InactiveUsers</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2 col-md-6">
            <div class="card" style="cursor:pointer;" onclick="filterByStatus('Suspended')" id="card-Suspended">
                <div class="card-body px-3 py-3">
                    <div class="row">
                        <div class="col-md-4 col-lg-12 col-xl-12 col-xxl-5 d-flex justify-content-start">
                            <div class="stats-icon yellow mb-2">
                                <i class="bi bi-archive-fill"></i>
                            </div>
                        </div>
                        <div class="col-md-8 col-lg-12 col-xl-12 col-xxl-7">
                            <h6 class="text-muted font-semibold">Archived</h6>
                            <h6 class="font-extrabold mb-0" id="countSuspended">@ViewBag.SuspendedUsers</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ─────────── Main Table Section ─────────── -->
<section class="section">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2" style="position: relative;">
            <span class="live-dot"></span>
            <h4 class="card-title mb-0" style="position: absolute; left: 30px;">All Medicine Batches</h4>
            <span class="badge bg-primary bg-opacity-10 text-primary" id="resultCount" style="font-size:11px;font-weight:600; position: absolute; left: 150px;">— records</span>
            <a href="#" data-url="@Url.Action("CreateBatch", "Medicine")" class="btn btn-primary btn-sm ajax-link">
                <i class="bi bi-plus-circle-fill me-1"></i> Add New Batch
            </a>
        </div>

        <div class="card-body">

            <!-- ── Batch Action Bar ── -->
            <div id="batchActionBar" class="d-none alert alert-primary d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3 mb-3" style="border-radius:8px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check2-square fs-5"></i>
                    <span id="batchSelectedCount" class="fw-semibold">0 medicines selected</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-sm btn-success"
                            asp-controller="Medicine" asp-action="BatchSetActive"
                            onclick="submitBatchForm(this, true)">
                        <i class="bi bi-check-circle me-1"></i> Set Active
                    </button>
                    <button class="btn btn-sm btn-warning text-white"
                            onclick="submitBatchForm(this, false)">
                        <i class="bi bi-slash-circle me-1"></i> Set Inactive
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            onclick="submitBatchAction('BatchArchive')">
                        <i class="bi bi-archive me-1"></i> Archive
                    </button>
                    <button class="btn btn-sm btn-outline-success"
                            onclick="submitBatchAction('BatchExport')">
                        <i class="bi bi-download me-1"></i> Export Selected
                    </button>
                    <div class="vr mx-1"></div>
                    <button class="btn btn-sm btn-danger"
                            onclick="submitBatchAction('BatchDelete')"
                            data-confirm="Permanently delete selected medicines? This cannot be undone.">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="clearBatchSelection()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Hidden batch form — posted to server -->
            <form id="batchForm" method="post" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="action" id="batchAction" />
                <input type="hidden" name="isActive" id="batchIsActive" />
                <div id="batchIdsContainer"></div>
            </form>

            <!-- ── Toolbar ── -->
            <div class="row mb-3 g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control"
                               placeholder="Search name, generic name, category…" oninput="applyFilters()" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select id="filterCategory" class="form-select" onchange="applyFilters()">
                        <option value="">All Categories</option>
                        <option value="Antibiotic">Antibiotic</option>
                        <option value="Analgesic">Analgesic</option>
                        <option value="Antiviral">Antiviral</option>
                        <option value="Cardiovascular">Cardiovascular</option>
                        <option value="Vitamin">Vitamin</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select id="filterManufacturer" class="form-select" onchange="applyFilters()">
                        <option value="">All Manufacturers</option>
                        <option value="Cipla">Cipla</option>
                        <option value="Dr Reddy">Dr Reddy</option>
                        <option value="Sun Pharma">Sun Pharma</option>
                        <option value="Lupin">Lupin</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select id="sortField" class="form-select" onchange="applyFilters()">
                        <option value="createdAt-desc">Newest First</option>
                        <option value="createdAt-asc">Oldest First</option>
                        <option value="name-asc">Name A→Z</option>
                        <option value="name-desc">Name Z→A</option>
                    </select>
                </div>
                <div class="col-6 col-md-2 d-flex gap-2 justify-content-end">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" title="Toggle Columns">
                            <i class="bi bi-layout-three-columns"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width:170px;">
                            <li class="px-1 py-1">
                                <label class="col-toggle-label">
                                    <input type="checkbox" class="form-check-input col-toggle" data-col="colPhone" checked> Generic Name
                                </label>
                            </li>
                            <li class="px-1 py-1">
                                <label class="col-toggle-label">
                                    <input type="checkbox" class="form-check-input col-toggle" data-col="colEmail" checked> Category
                                </label>
                            </li>
                            <li class="px-1 py-1">
                                <label class="col-toggle-label">
                                    <input type="checkbox" class="form-check-input col-toggle" data-col="colBranch" checked> Manufacturer
                                </label>
                            </li>
                            <li class="px-1 py-1">
                                <label class="col-toggle-label">
                                    <input type="checkbox" class="form-check-input col-toggle" data-col="colCreated" checked> Created At
                                </label>
                            </li>
                        </ul>
                    </div>
                    <button class="btn btn-outline-success btn-sm" onclick="exportExcel()" title="Export Excel">
                        <i class="bi bi-download"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="resetFilters()" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>

            <!-- ── Table ── -->
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="userTable">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" class="form-check-input" id="selectAll"
                                       onchange="toggleSelectAll(this)">
                            </th>
                            <th class="sortable" onclick="sortByCol('batchNumber')" style="cursor:pointer; white-space:nowrap;">
                                Batch <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colMedicine sortable" onclick="sortByCol('medicine')" style="cursor:pointer; white-space:nowrap;">
                                Medicine <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colSupplier sortable" onclick="sortByCol('supplier')" style="cursor:pointer; white-space:nowrap;">
                                Supplier <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colBranch sortable" onclick="sortByCol('branch')" style="cursor:pointer; white-space:nowrap;">
                                Branch <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="sortable" onclick="sortByCol('stock')" style="cursor:pointer; white-space:nowrap;">
                                Stock <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colPurchase sortable" onclick="sortByCol('purchasePrice')" style="cursor:pointer; white-space:nowrap;">
                                Purchase Price <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colSelling sortable" onclick="sortByCol('sellingPrice')" style="cursor:pointer; white-space:nowrap;">
                                Selling Price <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colMfg sortable" onclick="sortByCol('mfgDate')" style="cursor:pointer; white-space:nowrap;">
                                Mfg Date <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="sortable" onclick="sortByCol('expDate')" style="cursor:pointer; white-space:nowrap;">
                                Exp Date <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="sortable" onclick="sortByCol('status')" style="cursor:pointer; white-space:nowrap;">
                                Status <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="colCreated sortable" onclick="sortByCol('createdAt')" style="cursor:pointer; white-space:nowrap;">
                                Created At <i class="bi bi-chevron-expand text-muted ms-1" style="font-size:0.7rem;"></i>
                            </th>
                            <th class="text-center" style="white-space:nowrap;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="batchTableBody">
                        @{
                            var today = DateOnly.FromDateTime(DateTime.Today);
                            var next30Days = today.AddDays(30);
                        }
                        @foreach (var batch in ViewBag.Batches)
                        {
                            bool isExpired = batch.ExpDate < today;
                            bool isExpiringSoon = !isExpired && batch.ExpDate <= next30Days;

                            <tr class="batch-row" id="row-@batch.BatchId" style="cursor:pointer;"
                                data-id="@batch.BatchId"
                                data-batch-number="@batch.BatchNumber"
                                data-medicine-id="@batch.MedicineId"
                                data-supplier-id="@batch.SupplierId"
                                data-branch-id="@batch.BranchId"
                                data-stock="@batch.TotalStockReceived"
                                data-purchase-price="@batch.UnitPurchasePrice"
                                data-selling-price="@batch.UnitSellingPrice"
                                data-mfg="@batch.MfgDate.ToString("yyyy-MM-dd")"
                                data-exp="@batch.ExpDate.ToString("yyyy-MM-dd")"
                                data-grn="@batch.GrnNumber"
                                data-created="@batch.CreatedAt.ToString("yyyy-MM-dd")">

                                <td onclick="event.stopPropagation()">
                                    <input type="checkbox" class="form-check-input row-check"
                                           value="@batch.BatchId"
                                           onchange="onRowCheckChange(this)">
                                </td>

                                <td>
                                    <div>
                                        <strong>@batch.BatchNumber</strong><br />
                                        <small class="text-muted">@batch.BatchId</small>
                                    </div>
                                </td>

                                <td class="colMedicine">@batch.MedicineId</td>

                                <td class="colSupplier">@batch.SupplierId</td>

                                <td class="colBranch">@batch.BranchId</td>

                                <td>@batch.TotalStockReceived</td>

                                <td class="colPurchase">₹@batch.UnitPurchasePrice.ToString("0.00")</td>

                                <td class="colSelling">₹@batch.UnitSellingPrice.ToString("0.00")</td>

                                <td class="colMfg">@batch.MfgDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="text-danger fw-semibold" style="font-size:13px;">
                                            @batch.ExpDate.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="text-warning fw-semibold" style="font-size:13px;">
                                            @batch.ExpDate.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@batch.ExpDate.ToString("dd MMM yyyy")</span>
                                    }
                                </td>

                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="badge bg-warning text-dark">Expiring Soon</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>

                                <td class="colCreated">@batch.CreatedAt.ToString("dd MMM yyyy")</td>

                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary px-2 py-1 batchViewBtn"
                                            title="View"
                                            data-id="@batch.BatchId"
                                            onclick="event.stopPropagation()">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a class="btn btn-sm btn-outline-secondary px-2 py-1 ajax-link"
                                           title="Edit Batch"
                                           href="/Medicine/Batch/Edit-Batch?id=@batch.BatchId">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Empty state -->
            <div id="emptyState" class="d-none text-center py-5">
                <i class="bi bi-capsule-pill fs-1 text-muted d-block mb-2"></i>
                <p class="text-muted mb-2">No batch found matching your filters.</p>
                <button class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>

        </div>

        <!-- ── Footer / Pagination ── -->
        <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2"
             id="tableFooter"
             data-total-pages="@ViewBag.TotalPages"
             data-current-page="@ViewBag.page"
             data-page-size="@ViewBag.size">
            <div class="d-flex align-items-center gap-2">
                <small class="text-muted" id="resultsInfo">Showing 0 of 0 medicines</small>
                <select class="form-select form-select-sm" id="rowsPerPage" style="width:auto;">
                    <option value="5" selected="@(CurrentPageSize == 5 ? "selected" : null)">5</option>
                    <option value="10" selected="@(CurrentPageSize == 10 ? "selected" : null)">10</option>
                    <option value="25" selected="@(CurrentPageSize == 25 ? "selected" : null)">25</option>
                    <option value="50" selected="@(CurrentPageSize == 50 ? "selected" : null)">50</option>
                </select>
                <small class="text-muted">per page</small>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>
</section>