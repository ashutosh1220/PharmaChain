function psv_setView(v) {
  PSV.state.view = v;
  document.querySelectorAll('.psv-view-tab').forEach((el,i) => {
    el.classList.toggle('active', ['daily','monthly','branchwise'][i] === v);
  });
  psv_buildTrendChart();
}

function psv_applyFilters() {
  psv_updateMetrics();
  psv_buildTrendChart();
  psv_buildBranchBars();
  psv_buildTopMedicines();
  psv_buildCatChart();
  psv_buildGSTChart();
  psv_buildAuditChart();
}

function psv_resetFilters() {
  document.getElementById('psv-branch-filter').value = 'all';
  document.getElementById('psv-cat-filter').value = 'all';
  psv_applyFilters();
}

function psv_setPage(p) {
  document.querySelectorAll('.psv-nav-item').forEach(el => el.classList.remove('active'));
  event.currentTarget.classList.add('active');
  if (p === 'audit') {
    document.getElementById('psv-page-title').textContent = 'Trade Audit';
    document.getElementById('psv-page-sub').textContent = 'Drill-down audit across batches, invoiceItems, branches';
    document.getElementById('psv-charts-area').style.display = 'none';
    document.getElementById('psv-audit-section').style.display = 'block';
  } else {
    document.getElementById('psv-page-title').textContent = 'Sales Tracking';
    document.getElementById('psv-page-sub').textContent = 'Showing data across all branches • Updated just now';
    document.getElementById('psv-charts-area').style.display = 'block';
    document.getElementById('psv-audit-section').style.display = 'block';
  }
}

function psv_toggleDark() {
  PSV.state.dark = !PSV.state.dark;
  document.documentElement.setAttribute('data-psv-dark', PSV.state.dark);
  document.getElementById('psv-dark-toggle').classList.toggle('on', PSV.state.dark);
}

function psv_exportCSV() {
  const rows = [['Medicine','Category','Branch','Batch','Units','UnitPrice','Revenue','GST%','GSTAmt','Margin%']];
  PSV.auditTableData.forEach(r => {
    rows.push([
      psv_getMedName(r.medicineId), psv_getMedCat(r.medicineId), psv_getBranchName(r.branchId),
      r.batchId, r.quantity, r.unitPrice.toFixed(2), Math.round(r.revenue),
      r.gstPct, Math.round(r.gstAmt), r.margin.toFixed(1)
    ]);
  });
  const csv = rows.map(r => r.join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'}));
  a.download = 'pharmachain_sales.csv';
  a.click();
}

