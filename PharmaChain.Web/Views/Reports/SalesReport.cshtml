// ════════════════════════════════════════
//  AUDIT CHART
// ════════════════════════════════════════
let PSV_auditData = [];

function psv_buildAuditChart() {
  psv_destroyChart('audit');
  const metric  = document.getElementById('psv-audit-metric').value;
  const groupBy = document.getElementById('psv-audit-group').value;
  const branchF = document.getElementById('psv-audit-branch').value;

  let items = PSV.invoiceItems;
  if (branchF !== 'all') items = items.filter(i => i.branchId === branchF);
  if (PSV.state.auditDrill) {
    items = items.filter(i => {
      const d = PSV.state.auditDrill;
      if (d.type === 'category') return psv_getMedCat(i.medicineId) === d.value;
      if (d.type === 'branch')   return i.branchId === d.value;
      if (d.type === 'supplier') return psv_getSupplierName(i.batchId) === d.value;
      if (d.type === 'month')    return i.month === d.value;
      if (d.type === 'gst')      return (i.gstPercentage+'%') === d.value;
      return true;
    });
    document.getElementById('psv-audit-back').style.display = 'inline-block';
    document.getElementById('psv-drill-path').style.display = 'block';
    document.getElementById('psv-drill-path').textContent = 'Drilled into: ' + PSV.state.auditDrill.type.toUpperCase() + ' = "' + PSV.state.auditDrill.label + '"';
  } else {
    document.getElementById('psv-audit-back').style.display = 'none';
    document.getElementById('psv-drill-path').style.display = 'none';
  }

  // Group
  const map = {};
  const labelMap = {};
  items.forEach(i => {
    let key, label;
    if (groupBy === 'category')  { key = psv_getMedCat(i.medicineId); label = key; }
    else if (groupBy === 'branch')   { key = i.branchId; label = psv_getBranchName(i.branchId); }
    else if (groupBy === 'supplier') { key = psv_getSupplierName(i.batchId); label = key; }
    else if (groupBy === 'month')    { key = i.month; label = key; }
    else if (groupBy === 'gst')      { key = i.gstPercentage+'%'; label = 'GST ' + key; }
    if (!map[key]) { map[key] = { rev:0, units:0, gstAmt:0, cogs:0, count:0 }; labelMap[key] = label; }
    const base = i.totalPrice / (1 + i.gstPercentage/100);
    map[key].rev   += i.totalPrice;
    map[key].units += i.quantity;
    map[key].gstAmt+= (i.totalPrice - base);
    map[key].cogs  += psv_getBatchPurchasePrice(i.batchId) * i.quantity;
    map[key].count++;
  });

  let sorted = Object.entries(map).sort((a,b) => b[1].rev - a[1].rev);
  const labels = sorted.map(x => labelMap[x[0]] || x[0]);
  const getValue = entry => {
    if (metric === 'revenue')   return Math.round(entry.rev);
    if (metric === 'units')     return Math.round(entry.units);
    if (metric === 'gst')       return Math.round(entry.gstAmt);
    if (metric === 'margin')    return entry.rev>0 ? +((entry.rev - entry.cogs)/entry.rev*100).toFixed(1) : 0;
    if (metric === 'unitprice') return entry.units>0 ? +(entry.rev/entry.units).toFixed(2) : 0;
    return 0;
  };
  const data = sorted.map(x => getValue(x[1]));
  PSV_auditData = sorted.map((x,i) => ({ key: x[0], label: labelMap[x[0]]||x[0], data: x[1], value: data[i] }));

  const metricLabel = { revenue:'Revenue (₹)', units:'Units Sold', gst:'GST Amount (₹)', margin:'Gross Margin (%)', unitprice:'Avg Unit Price (₹)' }[metric];

  const ctx = document.getElementById('psv-auditChart').getContext('2d');
  PSV.state.charts.audit = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: metricLabel,
        data,
        backgroundColor: labels.map((_,i) => PSV_COLORS[i % PSV_COLORS.length] + 'cc'),
        hoverBackgroundColor: labels.map((_,i) => PSV_COLORS[i % PSV_COLORS.length]),
        borderRadius: 6, borderSkipped: false
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => {
              const v = ctx.parsed.y;
              if (metric === 'margin' || metric === 'unitprice') return ' ' + ctx.dataset.label + ': ' + v;
              return ' ' + ctx.dataset.label + ': ₹' + v.toLocaleString();
            }
          }
        }
      },
      scales: {
        x: { grid:{display:false}, ticks:{color:'#8a9e98', font:{size:11}, maxRotation:30} },
        y: { grid:{color:'rgba(128,128,128,0.08)'}, ticks:{color:'#8a9e98',font:{size:11},
          callback: v => (metric==='revenue'||metric==='gst') ? '₹'+psv_fmtNum(v) : (metric==='margin'||metric==='unitprice') ? v : psv_fmtNum(v)
        } }
      },
      onClick: (e, elements) => {
        if (elements.length && !PSV.state.auditDrill) {
          const idx = elements[0].index;
          const item = PSV_auditData[idx];
          PSV.state.auditDrill = { type: groupBy, value: item.key, label: item.label };
          psv_buildAuditChart();
          psv_buildAuditTable();
        }
      },
      onHover: (e, elements) => {
        e.native.target.style.cursor = elements.length && !PSV.state.auditDrill ? 'pointer' : 'default';
      },
      animation: { duration: 400 }
    }
  });

  psv_buildAuditTable();
  psv_buildAnomalies(items);
}

function psv_resetAuditDrill() {
  PSV.state.auditDrill = null;
  psv_buildAuditChart();
}

// ════════════════════════════════════════
//  ANOMALY DETECTION
// ════════════════════════════════════════
function psv_buildAnomalies(items) {
  const anomalies = [];

  // High GST mismatch
  items.forEach(i => {
    const med = PSV.medicines.find(m => m.medicineId === i.medicineId);
    if (med && med.gstPercentage !== i.gstPercentage) {
      anomalies.push({ type:'critical', text: `<strong>GST Mismatch</strong>: ${psv_getMedName(i.medicineId)} — invoiced at ${i.gstPercentage}% but master rate is ${med.gstPercentage}%`, time: i.month });
    }
  });

  // Price outliers: invoice price > batch selling price * 1.15
  const priceFlags = new Set();
  items.forEach(i => {
    const batch = PSV.batches.find(b => b.batchId === i.batchId);
    if (batch && i.unitPrice > batch.unitSellingPrice * 1.15 && !priceFlags.has(i.batchId)) {
      priceFlags.add(i.batchId);
      anomalies.push({ type:'warn', text: `<strong>Price Overrun</strong>: ${psv_getMedName(i.medicineId)} sold at ₹${i.unitPrice} vs. batch price ₹${batch.unitSellingPrice}`, time: i.month });
    }
  });

  // Near-expiry batch still being sold
  const today = new Date('2025-12-01');
  PSV.batches.forEach(b => {
    const exp = new Date(b.expDate);
    const days = Math.round((exp - today) / 86400000);
    if (days >= 0 && days < 120) {
      const hasItems = items.some(i => i.batchId === b.batchId);
      if (hasItems) {
        anomalies.push({ type: days < 60 ? 'critical' : 'warn', text: `<strong>Near-Expiry Sale</strong>: Batch ${b.batchNumber} (${psv_getMedName(b.medicineId)}) expires in ${days} days — still active in sales`, time: b.expDate });
      }
    }
  });

  // Low margin
  const medMargins = {};
  items.forEach(i => {
    if (!medMargins[i.medicineId]) medMargins[i.medicineId] = {rev:0,cogs:0};
    medMargins[i.medicineId].rev  += i.totalPrice;
    medMargins[i.medicineId].cogs += psv_getBatchPurchasePrice(i.batchId) * i.quantity;
  });
  Object.entries(medMargins).forEach(([mid,v]) => {
    const m = v.rev > 0 ? (v.rev - v.cogs)/v.rev*100 : 0;
    if (m < 10 && v.rev > 50000) {
      anomalies.push({ type:'warn', text: `<strong>Low Margin Alert</strong>: ${psv_getMedName(mid)} margin is ${m.toFixed(1)}% (below 10% threshold)`, time: 'FY2025' });
    }
  });

  if (anomalies.length === 0) {
    anomalies.push({ type:'ok', text: '<strong>No anomalies detected</strong> — all invoice items pass audit checks for the current filter', time: 'Now' });
  }

  const el = document.getElementById('psv-anomaly-list');
  el.innerHTML = anomalies.slice(0,6).map(a => `
    <div class="psv-anomaly-item ${a.type}">
      <span style="font-size:14px;">${a.type==='critical'?'🔴':a.type==='warn'?'🟡':'🟢'}</span>
      <span class="psv-anomaly-text">${a.text}</span>
      <span class="psv-anomaly-time">${a.time}</span>
    </div>
  `).join('');
}

// ════════════════════════════════════════
//  AUDIT TABLE
// ════════════════════════════════════════
PSV.auditTableData = [];

function psv_buildAuditTable() {
  let items = PSV.invoiceItems;
  const branchF = document.getElementById('psv-audit-branch').value;
  if (branchF !== 'all') items = items.filter(i => i.branchId === branchF);
  if (PSV.state.auditDrill) {
    const d = PSV.state.auditDrill;
    items = items.filter(i => {
      if (d.type==='category') return psv_getMedCat(i.medicineId) === d.value;
      if (d.type==='branch')   return i.branchId === d.value;
      if (d.type==='supplier') return psv_getSupplierName(i.batchId) === d.value;
      if (d.type==='month')    return i.month === d.value;
      if (d.type==='gst')      return (i.gstPercentage+'%') === d.value;
      return true;
    });
  }

  // Aggregate by medicine + batch + branch
  const map = {};
  items.forEach(i => {
    const k = i.medicineId + '|' + i.batchId + '|' + i.branchId;
    if (!map[k]) {
      map[k] = {
        medicineId: i.medicineId, batchId: i.batchId, branchId: i.branchId,
        quantity:0, revenue:0, gstAmt:0, gstPct: i.gstPercentage,
        unitPrice: i.unitPrice
      };
    }
    map[k].quantity += i.quantity;
    map[k].revenue  += i.totalPrice;
    const base = i.totalPrice / (1 + i.gstPercentage/100);
    map[k].gstAmt   += (i.totalPrice - base);
  });

  PSV.auditTableData = Object.values(map).map(r => {
    const cogs = psv_getBatchPurchasePrice(r.batchId) * r.quantity;
    const margin = r.revenue > 0 ? (r.revenue - cogs)/r.revenue*100 : 0;
    return { ...r, margin };
  });

  psv_renderAuditTable(PSV.auditTableData);
}

function psv_renderAuditTable(data) {
  const tbody = document.getElementById('psv-audit-tbody');
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="13" style="text-align:center;color:var(--psv-text3);padding:20px;">No data for current filter</td></tr>';
    return;
  }
  tbody.innerHTML = data.slice(0, 50).map((r, i) => {
    const marginClass = r.margin >= 25 ? 'high' : r.margin >= 12 ? 'medium' : 'low';
    const batch = PSV.batches.find(b => b.batchId === r.batchId);
    const batchNo = batch ? batch.batchNumber : r.batchId;
    const exp = batch ? new Date(batch.expDate) : null;
    const today = new Date('2025-12-01');
    const daysLeft = exp ? Math.round((exp-today)/86400000) : 999;
    const statusTag = daysLeft < 60 ? `<span class="psv-tag psv-tag-red">Expiring</span>`
      : daysLeft < 120 ? `<span class="psv-tag psv-tag-yellow">Near Exp</span>`
      : `<span class="psv-tag psv-tag-green">Active</span>`;
    return `
      <tr>
        <td>${i+1}</td>
        <td class="name">${psv_getMedName(r.medicineId)}</td>
        <td>${psv_getMedCat(r.medicineId)}</td>
        <td>${batchNo}</td>
        <td>${psv_getBranchName(r.branchId)}</td>
        <td>${psv_getSupplierName(r.batchId)}</td>
        <td>${r.quantity.toLocaleString()}</td>
        <td>₹${r.unitPrice.toFixed(2)}</td>
        <td>₹${Math.round(r.revenue).toLocaleString()}</td>
        <td>${r.gstPct}%</td>
        <td>₹${Math.round(r.gstAmt).toLocaleString()}</td>
        <td class="${marginClass}">${r.margin.toFixed(1)}%</td>
        <td>${statusTag}</td>
      </tr>
    `;
  }).join('');
}

function psv_filterAuditTable() {
  const q = document.getElementById('psv-audit-search').value.toLowerCase();
  if (!q) { psv_renderAuditTable(PSV.auditTableData); return; }
  const filtered = PSV.auditTableData.filter(r =>
    psv_getMedName(r.medicineId).toLowerCase().includes(q) ||
    psv_getMedCat(r.medicineId).toLowerCase().includes(q) ||
    psv_getBranchName(r.branchId).toLowerCase().includes(q) ||
    psv_getSupplierName(r.batchId).toLowerCase().includes(q)
  );
  psv_renderAuditTable(filtered);
}

function psv_sortAuditTable() {
  const s = document.getElementById('psv-audit-table-sort').value;
  let sorted = [...PSV.auditTableData];
  if (s === 'revenue_desc') sorted.sort((a,b) => b.revenue - a.revenue);
  if (s === 'revenue_asc')  sorted.sort((a,b) => a.revenue - b.revenue);
  if (s === 'units_desc')   sorted.sort((a,b) => b.quantity - a.quantity);
  if (s === 'margin_desc')  sorted.sort((a,b) => b.margin - a.margin);
  psv_renderAuditTable(sorted);
}

