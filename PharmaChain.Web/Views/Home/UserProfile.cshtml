@{
    ViewData["Title"] = "Pharma Chain - User Profile";
    Layout = "~/Views/Shared/_adminDashboard.cshtml";

    var userinfo = ViewBag.User;
    var userRole = ViewBag.UserRole;
    var userBranch = ViewBag.UserBranch;
    var branches = ViewBag.Branches as IEnumerable<dynamic>;
    var selectedBranchId = ViewBag.UserBranch?.BranchId;
    string fullName = userinfo?.FullName ?? "—";
    string phone = userinfo?.Phone ?? "—";
    string email = userinfo?.Email ?? "—";
    string dob = userinfo?.DateOfBirth != null
                            ? ((DateTime)userinfo.DateOfBirth).ToString("yyyy-MM-dd")
                            : "";
    string dobDisplay = userinfo?.DateOfBirth != null
                            ? ((DateTime)userinfo.DateOfBirth).ToString("dd MMM yyyy")
                            : "—";
    string gender = userinfo?.Gender ?? "Male";
    string roleName = userRole?.RoleName ?? "—";
    string branchName = userBranch?.BranchName ?? "—";
    string city = userinfo?.City ?? "—";
    bool isActive = userinfo?.IsActive == true;
    string statusText = isActive ? "Active" : (userinfo?.IsDeleted == true ? "Deleted" : "Inactive");
    string statusCss = isActive ? "on" : "off";

    string addrLine1 = userinfo?.AddressLine1 ?? "";
    string addrLine2 = userinfo?.AddressLine2 ?? "";
    string stateName = userinfo?.State ?? "";
    string country = userinfo?.Country ?? "";
    string pincode = userinfo?.Pincode ?? "";

    string idProofType = userinfo?.IdProofType ?? "Aadhaar Card";
    string idProofNum = userinfo?.IdProofNumber ?? "";
    string idDocPath = userinfo?.IdProofDocumentPath ?? "";
    string photoPath = userinfo?.ProfilePhotoPath ?? "";

    string createdBy = userinfo?.CreatedBy ?? "—";
    string createdAt = userinfo?.CreatedAt != null
                            ? ((DateTime)userinfo.CreatedAt).ToString("dd MMM yyyy, hh:mm tt")
                            : "—";
    string updatedAt = userinfo?.UpdatedAt != null
                            ? ((DateTime)userinfo.UpdatedAt).ToString("dd MMM yyyy, hh:mm tt")
                            : "—";
    bool isDeleted = userinfo?.IsDeleted == true;

    // Initials for avatar fallback
    string initials = "";

    if (string.IsNullOrWhiteSpace(photoPath))
    {
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            initials = parts.Length >= 2
                ? $"{parts[0][0]}{parts[^1][0]}"
                : fullName.Substring(0, Math.Min(2, fullName.Length));
            initials = initials.ToUpper();
        }
        else
        {
            initials = "??";
        }
    }
    else
    {
        initials = "";
    }
}
<div class="main">
    <div class="content">
        <!-- Heading -->
        <div class="page-top">
            <div><h3>User Profile</h3><p>View and manage user account details.</p></div>
            <input type="hidden" id="userId" value="@userinfo?.UserId" />
            <nav>
                <ol class="breadcrumb">
                    <li><a href="#">Dashboard</a></li>
                    <li><a href="#">Users</a></li>
                    <li class="act">Profile</li>
                </ol>
            </nav>
        </div>

        <div class="pg">
            <!-- LEFT -->
            <div class="stack">

                <!-- Header card -->
                <div class="card">
                    <div class="ph-body">
                        <div class="av-wrap">
                            <div class="av-circle" id="avCircle">
                                <span id="avInit">@initials</span>
                                @if (!string.IsNullOrEmpty(photoPath))
                                {
                                    <img id="avImg" src="@photoPath" alt="Profile Photo" style="display:block;" />
                                }
                                else
                                {
                                    <img id="avImg" src="" alt="" style="display:none;" />
                                }
                            </div>
                            <div class="st-dot @statusCss" id="stDot"></div>
                            <div class="av-cam" onclick="document.getElementById('avFile').click()" title="Change photo">
                                <i class="bi bi-camera-fill"></i>
                            </div>
                            <input type="file" id="avFile" accept="image/*" style="display:none;"
                                   data-field="ProfilePhotoPath"
                                   onchange="changeAvatar(event)" />
                        </div>
                        <div class="ph-name" id="dName">@fullName</div>
                        <div class="role-chip"><i class="bi bi-shield-fill"></i><span id="dRole">@roleName</span></div>
                        <div class="meta-pills">
                            <span class="meta-pill"><i class="bi bi-geo-alt-fill"></i><span id="dCity">@city</span></span>
                            <span class="meta-pill"><i class="bi bi-building-fill"></i><span id="dBranch">@branchName</span></span>
                            <span class="meta-pill"><i class="bi bi-telephone-fill"></i>@phone</span>
                        </div>
                        <span class="st-badge @statusCss" id="stBadge">
                            <i class="bi bi-circle-fill" style="font-size:7px;"></i> @statusText
                        </span>
                        <div class="hdr-actions">
                            <button class="btn btn-ol btn-sm" onclick="toast('Reset link sent.','info')"><i class="bi bi-key"></i> Reset Password</button>
                            <button class="btn btn-olw btn-sm" onclick="toast('User suspended.','warning')"><i class="bi bi-pause-circle"></i> Suspend</button>
                        </div>
                    </div>
                </div>

                <!-- Stats -->
                <div class="card">
                    <div class="card-header"><span class="card-title"><i class="bi bi-bar-chart-fill"></i>Activity Stats</span></div>
                    <div class="ms-grid">
                        <div class="ms-cell"><div class="ms-num tc-p">142</div><div class="ms-lbl">Invoices</div></div>
                        <div class="ms-cell"><div class="ms-num tc-s">98%</div><div class="ms-lbl">Accuracy</div></div>
                        <div class="ms-cell"><div class="ms-num tc-w">67</div><div class="ms-lbl">Days Active</div></div>
                        <div class="ms-cell"><div class="ms-num tc-i">3</div><div class="ms-lbl">Branches</div></div>
                    </div>
                </div>

                <!-- Activity -->
                <div class="card">
                    <div class="card-header"><span class="card-title"><i class="bi bi-activity"></i>Recent Activity</span></div>
                    <div class="card-body" style="padding-top:10px;padding-bottom:10px;">
                        <div class="act-item"><div class="act-dot" style="background:var(--success);"></div><div><div class="act-text">Created Invoice <strong>#INV-0042</strong></div><div class="act-time">2 hours ago</div></div></div>
                        <div class="act-item"><div class="act-dot" style="background:var(--primary);"></div><div><div class="act-text">Updated stock — <strong>Paracetamol 500mg</strong></div><div class="act-time">Yesterday, 3:14 PM</div></div></div>
                        <div class="act-item"><div class="act-dot" style="background:var(--warning);"></div><div><div class="act-text">Password reset requested</div><div class="act-time">21 Mar 2025</div></div></div>
                        <div class="act-item"><div class="act-dot" style="background:var(--info);"></div><div><div class="act-text">Profile created by <strong>Admin</strong></div><div class="act-time">@createdAt</div></div></div>
                    </div>
                </div>

            </div><!-- /left -->
            <!-- RIGHT -->
            <div class="stack">

                <!-- Basic Info -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title"><i class="bi bi-person-fill"></i>Basic Information</span>
                        <button class="btn btn-gp btn-sm" onclick="editSec('basic')"><i class="bi bi-pencil"></i>Edit All</button>
                    </div>
                    <div class="card-body">
                        <div class="g2">

                            <div class="fg">
                                <label class="fl">User ID</label>
                                <div class="ro-val">@(userinfo?.UserId ?? "—")</div>
                            </div>

                            <div class="fg">
                                <label class="fl">Full Name <span class="req">*</span></label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fName" value="@fullName" disabled
                                               data-sec="basic" data-disp="dName" data-field="FullName" />
                                        <button class="feb" id="eb-fName" onclick="te('fName')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fName" onclick="sf('fName')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Phone <span class="req">*</span></label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="tel" id="fPhone" value="@phone" disabled
                                               data-sec="basic" data-field="Phone" />
                                        <button class="feb" id="eb-fPhone" onclick="te('fPhone')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fPhone" onclick="sf('fPhone')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Email <span class="req">*</span></label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="email" id="fEmail" value="@email" disabled
                                               data-sec="basic" data-field="Email" />
                                        <button class="feb" id="eb-fEmail" onclick="te('fEmail')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fEmail" onclick="sf('fEmail')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Date of Birth</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="date" id="fDob" value="@dob" disabled
                                               data-sec="basic" data-field="DateOfBirth" />
                                        <button class="feb" id="eb-fDob" onclick="te('fDob')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fDob" onclick="sf('fDob')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Gender</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <select id="fGender" disabled data-sec="basic" data-field="Gender">
                                            @if (gender == "Male")
                                            {
                                                <option value="Male" selected>Male</option>
                                            }
                                            else
                                            {
                                                <option value="Male">Male</option>
                                            }
                                            @if (gender == "Female")
                                            {
                                                <option value="Female" selected>Female</option>
                                            }
                                            else
                                            {
                                                <option value="Female">Female</option>
                                            }
                                            @if (gender == "Other")
                                            {
                                                <option value="Other" selected>Other</option>
                                            }
                                            else
                                            {
                                                <option value="Other">Other</option>
                                            }
                                        </select>
                                        <button class="feb" id="eb-fGender" onclick="te('fGender')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fGender" onclick="sf('fGender')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Role & Access -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title"><i class="bi bi-shield-lock-fill"></i>Role &amp; Access</span>
                        <button class="btn btn-gp btn-sm" onclick="editSec('access')"><i class="bi bi-pencil"></i>Edit All</button>
                    </div>
                    <div class="card-body">
                        <div class="g2">

                            <div class="fg">
                                <label class="fl">Role <span class="req">*</span></label>
                                <div class="fr">
                                    <div class="fiw">
                                        <select id="fRole" disabled data-sec="access" data-disp="dRole" data-field="RoleId">
                                            @if (roleName == "SuperAdmin")
                                            {
                                                <option value="5" selected>Super Admin</option>
                                            }
                                            else
                                            {
                                                <option value="5">Super Admin</option>
                                            }
                                            @if (roleName == "Admin")
                                            {
                                                <option value="6" selected>Admin</option>
                                            }
                                            else
                                            {
                                                <option value="6">Admin</option>
                                            }
                                            @if (roleName == "BranchManager")
                                            {
                                                <option value="7" selected>Branch Manager</option>
                                            }
                                            else
                                            {
                                                <option value="7">Branch Manager</option>
                                            }
                                            @if (roleName == "Pharmacist")
                                            {
                                                <option value="8" selected>Pharmacist</option>
                                            }
                                            else
                                            {
                                                <option value="8">Pharmacist</option>
                                            }
                                            @if (roleName == "Cashier")
                                            {
                                                <option value="9" selected>Cashier</option>
                                            }
                                            else
                                            {
                                                <option value="9">Cashier</option>
                                            }
                                            @if (roleName == "StockManager")
                                            {
                                                <option value="10" selected>Stock Manager</option>
                                            }
                                            else
                                            {
                                                <option value="10">Stock Manager</option>
                                            }
                                            @if (roleName == "Auditor")
                                            {
                                                <option value="11" selected>Auditor</option>
                                            }
                                            else
                                            {
                                                <option value="11">Auditor</option>
                                            }
                                        </select>
                                        <button class="feb" id="eb-fRole" onclick="te('fRole')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fRole" onclick="sf('fRole')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Branch <span class="req">*</span></label>
                                <div class="fr">
                                    <div class="fiw">
                                        <select id="fBranch" disabled
                                                data-sec="access"
                                                data-disp="dBranch"
                                                data-field="BranchId">

                                            <option value="">-- Select Branch --</option>

                                            @foreach (var branch in branches)
                                            {
                                                if (!branch.IsDeleted)
                                                {
                                                    <option value="@branch.BranchId"
                                                            selected="@(branch.BranchId == selectedBranchId ? "selected" : null)">
                                                        @branch.BranchName
                                                    </option>
                                                }
                                            }
                                        </select>
                                        <button class="feb" id="eb-fBranch" onclick="te('fBranch')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fBranch" onclick="sf('fBranch')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Account Status</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <select id="fStatus" disabled data-sec="access" data-field="IsActive"
                                                onchange="syncStatus(this.value)">
                                            @if (statusText == "Active")
                                            {
                                                <option value="1" selected>Active</option>
                                            }
                                            else
                                            {
                                                <option value="1">Active</option>
                                            }
                                            @if (statusText == "Inactive")
                                            {
                                                <option value="0" selected>Inactive</option>
                                            }
                                            else
                                            {
                                                <option value="0">Inactive</option>
                                            }
                                            @if (statusText == "Suspended")
                                            {
                                                <option value="0" selected>Suspended</option>
                                            }
                                            else
                                            {
                                                <option value="0">Suspended</option>
                                            }
                                        </select>
                                        <button class="feb" id="eb-fStatus" onclick="te('fStatus')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fStatus" onclick="sf('fStatus')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>

                            <div class="fg">
                                <label class="fl">Created At</label>
                                <div class="ro-val">@createdAt</div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title"><i class="bi bi-geo-alt-fill"></i>Address</span>
                        <button class="btn btn-gp btn-sm" onclick="editSec('addr')"><i class="bi bi-pencil"></i>Edit All</button>
                    </div>
                    <div class="card-body">
                        <div class="g1">
                            <div class="fg">
                                <label class="fl">Address Line 1</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fA1" value="@addrLine1" disabled
                                               data-sec="addr" data-field="AddressLine1" />
                                        <button class="feb" id="eb-fA1" onclick="te('fA1')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fA1" onclick="sf('fA1')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg">
                                <label class="fl">Address Line 2</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fA2" value="@addrLine2" disabled
                                               data-sec="addr" data-field="AddressLine2" />
                                        <button class="feb" id="eb-fA2" onclick="te('fA2')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fA2" onclick="sf('fA2')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="g2" style="margin-top:14px;">
                            <div class="fg">
                                <label class="fl">City</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fCity" value="@city" disabled
                                               data-sec="addr" data-disp="dCity" data-field="City" />
                                        <button class="feb" id="eb-fCity" onclick="te('fCity')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fCity" onclick="sf('fCity')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg">
                                <label class="fl">State</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fState" value="@stateName" disabled
                                               data-sec="addr" data-field="State" />
                                        <button class="feb" id="eb-fState" onclick="te('fState')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fState" onclick="sf('fState')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg">
                                <label class="fl">Country</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fCountry" value="@country" disabled
                                               data-sec="addr" data-field="Country" />
                                        <button class="feb" id="eb-fCountry" onclick="te('fCountry')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fCountry" onclick="sf('fCountry')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg">
                                <label class="fl">Pincode</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fPin" value="@pincode" maxlength="6" disabled
                                               data-sec="addr" data-field="Pincode" />
                                        <button class="feb" id="eb-fPin" onclick="te('fPin')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fPin" onclick="sf('fPin')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ID Proof -->
                <div class="card">
                    <div class="card-header"><span class="card-title"><i class="bi bi-card-text"></i>ID Proof &amp; Documents</span></div>
                    <div class="card-body">
                        <div class="g2">
                            <div class="fg">
                                <label class="fl">ID Proof Type</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <select id="fIdT" disabled data-sec="id" data-field="IdProofType">
                                            @if (idProofType == "Aadhaar Card")
                                            {
                                                <option value="Aadhaar Card" selected>Aadhaar Card</option>
                                            }
                                            else
                                            {
                                                <option value="Aadhaar Card">Aadhaar Card</option>
                                            }
                                            @if (idProofType == "PAN Card")
                                            {
                                                <option value="PAN Card" selected>PAN Card</option>
                                            }
                                            else
                                            {
                                                <option value="PAN Card">PAN Card</option>
                                            }
                                            @if (idProofType == "Passport")
                                            {
                                                <option value="Passport" selected>Passport</option>
                                            }
                                            else
                                            {
                                                <option value="Passport">Passport</option>
                                            }
                                            @if (idProofType == "Driving License")
                                            {
                                                <option value="Driving License" selected>Driving License</option>
                                            }
                                            else
                                            {
                                                <option value="Driving License">Driving License</option>
                                            }
                                            @if (idProofType == "Voter ID")
                                            {
                                                <option value="Voter ID" selected>Voter ID</option>
                                            }
                                            else
                                            {
                                                <option value="Voter ID">Voter ID</option>
                                            }
                                        </select>
                                        <button class="feb" id="eb-fIdT" onclick="te('fIdT')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fIdT" onclick="sf('fIdT')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg">
                                <label class="fl">ID Number</label>
                                <div class="fr">
                                    <div class="fiw">
                                        <input type="text" id="fIdN" value="@idProofNum" disabled
                                               data-sec="id" data-field="IdProofNumber" />
                                        <button class="feb" id="eb-fIdN" onclick="te('fIdN')"><i class="bi bi-pencil"></i></button>
                                    </div>
                                    <button class="fsb" id="sb-fIdN" onclick="sf('fIdN')"><i class="bi bi-check-lg"></i></button>
                                </div>
                            </div>
                            <div class="fg" style="grid-column:span 2;">
                                <label class="fl">Uploaded Document</label>
                                <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;">
                                    @if (!string.IsNullOrEmpty(idDocPath))
                                    {
                                        var fileName = System.IO.Path.GetFileName(idDocPath);
                                        <a href="@idDocPath" class="doc-badge" target="_blank">
                                            <i class="bi bi-file-earmark-pdf-fill tc-d"></i>
                                            <span>@fileName</span>
                                            <i class="bi bi-download tc-m" style="font-size:13px;margin-left:4px;"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="tc-m" style="font-size:13px;">No document uploaded.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Info -->
                <div class="card">
                    <div class="card-header"><span class="card-title"><i class="bi bi-info-circle-fill"></i>System Information</span></div>
                    <div class="card-body">
                        <div class="g2">
                            <div class="fg"><label class="fl">Created By</label><div class="ro-val">@createdBy</div></div>
                            <div class="fg"><label class="fl">Created At</label><div class="ro-val">@createdAt</div></div>
                            <div class="fg"><label class="fl">Last Updated</label><div class="ro-val">@updatedAt</div></div>
                            <div class="fg"><label class="fl">Is Deleted</label><div class="ro-val">@(isDeleted ? "Yes" : "No")</div></div>
                        </div>
                    </div>
                </div>

            </div><!-- /right -->
        </div><!-- /pg -->

        <div class="pg-footer"><span>&copy; 2025 Pharmacy Admin</span><span>Pharmacy Management System</span></div>
    </div>
</div>
